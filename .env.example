code .env.example
```

Paste this, **Ctrl+S**:
```
# =====================================================
#  Copy this file to .env and fill in your own values
#  NEVER commit .env to git
# =====================================================

# --- AI PROVIDER (pick one to start) ---
# Groq is recommended — free tier, fast
# Get key at: console.groq.com
GROQ_API_KEY=

# Anthropic Claude — console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini (free) — aistudio.google.com
GEMINI_API_KEY=

# OpenAI — platform.openai.com
OPENAI_API_KEY=

# OpenRouter — openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama — no key needed, runs offline
OLLAMA_HOST=http://localhost:11434

# --- WHICH PROVIDER TO USE ---
# Options: groq | claude | gemini | openai | openrouter | ollama
DEFAULT_AI_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# --- TELEGRAM ---
# Create bot at @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal Telegram ID — get from @userinfobot
TELEGRAM_ALLOWED_USER_ID=

# --- DESIGN APPS (add paths for what you have) ---
# Example: C:/Program Files/Adobe/Adobe Photoshop 2025/Photoshop.exe
PHOTOSHOP_PATH=
CORELDRAW_PATH=
GIMP_PATH=
INKSCAPE_PATH=
KRITA_PATH=

# Figma token — figma.com > Settings > Access Tokens
FIGMA_ACCESS_TOKEN=

# --- OUTPUT FOLDERS ---
OUTPUT_FOLDER=./output/designs
SHOWCASE_OUTPUT_FOLDER=./output/showcase
UPLOADS_FOLDER=./output/uploads
BRAND_KIT_FOLDER=./config/brand_kit
DATABASE_PATH=./config/agent.db

# --- LOCAL UI ---
LOCAL_UI_PORT=3000

# --- PRIVACY ---
PRIVACY_MODE=true
AUTO_DELETE_HISTORY_DAYS=0